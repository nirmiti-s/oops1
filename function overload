#include<iostream>
using namespace std;

class result
{
public:
void calculateAverage(int a, int b)
{
cout<<(a+b)/2.0<<endl;
}
void calculateAverage(int a, int b, int c)
{
cout<<(a+b+c)/3.0<<endl;
}
void calculateAverage(float a, float b)
{
cout<<(a+b)/2.0<<endl;
}
};
int main()
{
result r;
r.calculateAverage(90, 80);
r.calculateAverage(89, 75, 64);
r.calculateAverage(34.9f, 99.8f);
return 0;
}


