#include<iostream>
using namespace std;

template <class T>
void  swapvalues(T &a, T &b)
{
T temp;
temp = a;
a= b;
b = temp;
}
int main()
{
int employeeID = 101;
int roomNumber = 205;

cout<<"Before swapping: "<<endl;
cout<<"Employee ID: "<<employeeID<<endl;
cout<<"Room NUmber: "<<roomNumber<<endl;

swapvalues(employeeID, roomNumber);

cout<<"\nAfter swapping: "<<endl;
cout<<"Employee ID: "<<employeeID<<endl;
cout<<"Room Number: "<<roomNumber<<endl;

return 0;
}




